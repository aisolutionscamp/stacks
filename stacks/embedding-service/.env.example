# Embedding Service settings. Copy to .env and edit.

# Hugging Face model for embeddings. BAAI/bge-base-en-v1.5: English,
# 768 dimensions, about 440 MB download. Any model TEI supports works,
# e.g. BAAI/bge-small-en-v1.5 (384 dims) or BAAI/bge-m3 (multilingual).
EMBED_MODEL_ID=BAAI/bge-base-en-v1.5
# Model revision (branch, tag or commit hash). Pin a commit hash for
# reproducible deployments.
EMBED_MODEL_REVISION=main

# Host port for the embeddings API (bound to 127.0.0.1 only).
EMBED_PORT=8080

# Optional API key. When set, every request except /health and /metrics
# needs "Authorization: Bearer <key>". Leave empty to disable.
# Generate one with: openssl rand -hex 32
API_KEY=

# Optional Hugging Face token, only needed for gated or private models.
HF_TOKEN=

# Maximum number of inputs per request.
MAX_CLIENT_BATCH_SIZE=32
# Truncate inputs longer than the model's maximum length instead of
# returning an error.
AUTO_TRUNCATE=true

# Optional reranker service. Enable with COMPOSE_PROFILES=reranker
# (here or on the command line).
COMPOSE_PROFILES=
# Reranker model. BAAI/bge-reranker-base is about 1.1 GB.
RERANK_MODEL_ID=BAAI/bge-reranker-base
RERANK_MODEL_REVISION=main
# Host port for the reranker API (bound to 127.0.0.1 only).
RERANK_PORT=8081
