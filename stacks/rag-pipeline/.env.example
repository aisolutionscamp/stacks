# RAG Pipeline settings. Copy to .env and adjust.

# --- Secrets -----------------------------------------------------------------
# Required. API key for Qdrant (used by rag-api and the Qdrant dashboard).
# Generate with: openssl rand -hex 32
QDRANT_API_KEY=
# Recommended. Clients must send it as "X-API-Key: <key>" or
# "Authorization: Bearer <key>". Empty disables authentication on rag-api.
# Generate with: openssl rand -hex 32
RAG_API_KEY=

# --- Models (pulled by rag-api on first start) --------------------------------
# Embedding model in Ollama. Changing it later needs a new QDRANT_COLLECTION,
# because the vector size changes.
EMBED_MODEL=nomic-embed-text:v1.5
# Chat model that writes the answers.
CHAT_MODEL=llama3.2:3b
# Pull missing models automatically on start (true/false).
PULL_MODELS=true
# How long Ollama keeps a model in memory after a request.
OLLAMA_KEEP_ALIVE=5m

# --- Retrieval ----------------------------------------------------------------
# Qdrant collection that holds the chunks.
QDRANT_COLLECTION=documents
# Chunk size and overlap in characters.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Number of chunks passed to the model per question.
TOP_K=4
# Maximum size of one uploaded file or JSON request, in MB.
MAX_UPLOAD_MB=20
# Seconds to wait for the model (CPU inference can be slow).
LLM_TIMEOUT=300
# Sampling temperature for answers.
LLM_TEMPERATURE=0.1

# --- Ports (published on 127.0.0.1 only) --------------------------------------
RAG_API_PORT=8000
# Address rag-api is published on. Use 0.0.0.0 only behind a firewall or TLS proxy.
RAG_API_BIND=127.0.0.1
QDRANT_PORT=6333
OLLAMA_PORT=11434

# --- Image -------------------------------------------------------------------
# Tag of ghcr.io/aisolutionscamp/rag-api (also used for the local build).
RAG_API_VERSION=1.0.1
