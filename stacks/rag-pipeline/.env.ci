# Throwaway CI settings: tiny models so the smoke test runs on a CPU runner.
# Secrets are appended by ci-secrets.sh.
EMBED_MODEL=all-minilm:22m
CHAT_MODEL=qwen2.5:0.5b
PULL_MODELS=true
OLLAMA_KEEP_ALIVE=10m
QDRANT_COLLECTION=ci
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=3
MAX_UPLOAD_MB=5
LLM_TIMEOUT=300
LLM_TEMPERATURE=0
RAG_API_PORT=8000
RAG_API_BIND=127.0.0.1
QDRANT_PORT=6333
OLLAMA_PORT=11434
RAG_API_VERSION=1.0.1
