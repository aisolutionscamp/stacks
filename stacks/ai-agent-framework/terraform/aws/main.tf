# AI Agent Framework on AWS: one EC2 instance (Amazon Linux 2023) that runs the
# same Docker Compose stack (Flowise + Ollama + PostgreSQL) via user_data.
# - Secrets are generated by Terraform and stored as SSM SecureString parameters;
#   the instance reads them at boot with its IAM role.
# - Flowise (port 3000) is reachable only from var.allowed_cidr. No SSH: use SSM Session Manager.
# - Plain HTTP. Put TLS in front (ALB with ACM, or a reverse proxy) before real use.
#
#   terraform init
#   terraform apply -var 'allowed_cidr=203.0.113.10/32' -var 'flowise_admin_email=you@example.com'

terraform {
  required_version = ">= 1.5"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.7"
    }
  }
}

provider "aws" {
  region = var.aws_region
}

# ---------------------------------------------------------------- variables

variable "aws_region" {
  description = "AWS region"
  type        = string
  default     = "eu-central-1"
}

variable "name" {
  description = "Name prefix for all resources and the SSM parameter path"
  type        = string
  default     = "ai-agent-framework"
}

variable "allowed_cidr" {
  description = "CIDR allowed to reach Flowise on port 3000, e.g. your office IP as 203.0.113.10/32"
  type        = string

  validation {
    condition     = can(cidrhost(var.allowed_cidr, 0)) && var.allowed_cidr != "0.0.0.0/0"
    error_message = "allowed_cidr must be a valid CIDR and not 0.0.0.0/0."
  }
}

variable "instance_type" {
  description = "EC2 instance type. CPU-only; 16 GB RAM fits a 3B model plus Flowise and PostgreSQL"
  type        = string
  default     = "t3.xlarge"
}

variable "root_volume_size_gb" {
  description = "Root EBS volume size in GB (Docker images about 13 GB unpacked, plus models and data)"
  type        = number
  default     = 60
}

variable "ollama_model" {
  description = "Ollama model pulled on boot; use one with tool calling for agents"
  type        = string
  default     = "llama3.2:3b"
}

variable "flowise_admin_email" {
  description = "Email of the Flowise owner account (created on first boot)"
  type        = string
}

# ---------------------------------------------------------------- network

data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
  filter {
    name   = "default-for-az"
    values = ["true"]
  }
}

data "aws_ssm_parameter" "al2023_ami" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
}

resource "aws_security_group" "flowise" {
  name        = "${var.name}-sg"
  description = "Flowise UI/API from allowed_cidr only"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "Flowise"
    from_port   = 3000
    to_port     = 3000
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }

  egress {
    description = "Outbound for image and model downloads, SSM"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

# ---------------------------------------------------------------- secrets (SSM)

locals {
  secret_names = [
    "POSTGRES_PASSWORD",
    "FLOWISE_SECRETKEY_OVERWRITE",
    "JWT_AUTH_TOKEN_SECRET",
    "JWT_REFRESH_TOKEN_SECRET",
    "EXPRESS_SESSION_SECRET",
    "TOKEN_HASH_SECRET",
  ]
  ssm_prefix = "/${var.name}"
}

resource "random_password" "secret" {
  for_each = toset(local.secret_names)
  length   = 64
  special  = false
}

# Flowise requires upper and lower case, a digit and a special character.
resource "random_password" "admin" {
  length           = 24
  min_upper        = 2
  min_lower        = 2
  min_numeric      = 2
  min_special      = 2
  override_special = "-_.,"
}

resource "aws_ssm_parameter" "secret" {
  for_each = random_password.secret
  name     = "${local.ssm_prefix}/${each.key}"
  type     = "SecureString"
  value    = each.value.result
}

resource "aws_ssm_parameter" "admin_password" {
  name  = "${local.ssm_prefix}/FLOWISE_ADMIN_PASSWORD"
  type  = "SecureString"
  value = random_password.admin.result
}

# ---------------------------------------------------------------- IAM (SSM access)

data "aws_caller_identity" "current" {}

resource "aws_iam_role" "instance" {
  name = "${var.name}-instance"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "ssm_core" {
  role       = aws_iam_role.instance.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
}

resource "aws_iam_role_policy" "read_secrets" {
  name = "${var.name}-read-secrets"
  role = aws_iam_role.instance.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["ssm:GetParameter", "ssm:GetParametersByPath"]
      Resource = "arn:aws:ssm:${var.aws_region}:${data.aws_caller_identity.current.account_id}:parameter${local.ssm_prefix}/*"
    }]
  })
}

resource "aws_iam_instance_profile" "instance" {
  name = "${var.name}-instance"
  role = aws_iam_role.instance.name
}

# ---------------------------------------------------------------- instance

locals {
  # Same services as compose.yaml; Flowise listens on all interfaces here
  # (the security group limits access), Ollama stays on 127.0.0.1.
  compose_yaml = <<-EOT
    name: ai-agent-framework
    services:
      postgres:
        image: postgres:18.4-alpine
        restart: unless-stopped
        environment:
          POSTGRES_DB: flowise
          POSTGRES_USER: flowise
          POSTGRES_PASSWORD: $${POSTGRES_PASSWORD:?missing}
        volumes: [postgres_data:/var/lib/postgresql]
        healthcheck:
          test: ["CMD-SHELL", "pg_isready -U flowise -d flowise"]
          interval: 5s
          retries: 20
      ollama:
        image: ollama/ollama:0.40.11
        restart: unless-stopped
        volumes: [ollama_data:/root/.ollama]
        ports: ["127.0.0.1:11434:11434"]
        healthcheck:
          test: ["CMD", "ollama", "list"]
          interval: 10s
          retries: 12
      ollama-pull:
        image: ollama/ollama:0.40.11
        restart: "no"
        depends_on: {ollama: {condition: service_healthy}}
        environment: {OLLAMA_HOST: "http://ollama:11434"}
        entrypoint: ["ollama", "pull", "$${OLLAMA_MODEL}"]
      flowise:
        image: flowiseai/flowise:3.1.4
        restart: unless-stopped
        depends_on:
          postgres: {condition: service_healthy}
          ollama: {condition: service_healthy}
        environment:
          PORT: "3000"
          APP_URL: $${APP_URL}
          DATABASE_TYPE: postgres
          DATABASE_HOST: postgres
          DATABASE_PORT: "5432"
          DATABASE_NAME: flowise
          DATABASE_USER: flowise
          DATABASE_PASSWORD: $${POSTGRES_PASSWORD:?missing}
          FLOWISE_SECRETKEY_OVERWRITE: $${FLOWISE_SECRETKEY_OVERWRITE:?missing}
          JWT_AUTH_TOKEN_SECRET: $${JWT_AUTH_TOKEN_SECRET:?missing}
          JWT_REFRESH_TOKEN_SECRET: $${JWT_REFRESH_TOKEN_SECRET:?missing}
          EXPRESS_SESSION_SECRET: $${EXPRESS_SESSION_SECRET:?missing}
          TOKEN_HASH_SECRET: $${TOKEN_HASH_SECRET:?missing}
          JWT_ISSUER: Flowise
          JWT_AUDIENCE: Flowise
          SECRETKEY_PATH: /home/node/.flowise
          BLOB_STORAGE_PATH: /home/node/.flowise/storage
          LOG_PATH: /home/node/.flowise/logs
          LOG_LEVEL: info
          DISABLE_FLOWISE_TELEMETRY: "true"
        volumes: [flowise_data:/home/node]
        ports: ["3000:3000"]
        healthcheck:
          test: ["CMD", "curl", "-fsS", "http://localhost:3000/api/v1/ping"]
          interval: 10s
          retries: 30
          start_period: 30s
      flowise-setup:
        image: flowiseai/flowise:3.1.4
        restart: "no"
        depends_on: {flowise: {condition: service_healthy}}
        environment:
          FLOWISE_ADMIN_NAME: Admin
          FLOWISE_ADMIN_EMAIL: $${FLOWISE_ADMIN_EMAIL:?missing}
          FLOWISE_ADMIN_PASSWORD: $${FLOWISE_ADMIN_PASSWORD:?missing}
        entrypoint:
          - node
          - -e
          - |
            const e = process.env;
            const body = { user: { name: e.FLOWISE_ADMIN_NAME, email: e.FLOWISE_ADMIN_EMAIL, credential: e.FLOWISE_ADMIN_PASSWORD } };
            fetch("http://flowise:3000/api/v1/account/register", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) })
              .then(async (r) => { const t = await r.text();
                if (r.ok || t.includes("only have one organization")) return console.log("owner account ready");
                console.error("setup failed: " + r.status + " " + t); process.exit(1); })
              .catch((err) => { console.error(err); process.exit(1); });
    volumes:
      postgres_data:
      ollama_data:
      flowise_data:
  EOT

  user_data = <<-EOT
    #!/bin/bash
    set -euo pipefail
    dnf install -y docker
    mkdir -p /usr/local/lib/docker/cli-plugins
    curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
      https://github.com/docker/compose/releases/download/v5.6.1/docker-compose-linux-x86_64
    chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
    systemctl enable --now docker

    mkdir -p /opt/ai-agent-framework
    cd /opt/ai-agent-framework
    cat > compose.yaml <<'COMPOSE'
    ${local.compose_yaml}
    COMPOSE

    TOKEN=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')
    PUBLIC_IP=$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/public-ipv4 || echo localhost)
    umask 077
    {
      for k in ${join(" ", concat(local.secret_names, ["FLOWISE_ADMIN_PASSWORD"]))}; do
        echo "$k=$(aws ssm get-parameter --region ${var.aws_region} --with-decryption --name "${local.ssm_prefix}/$k" --query Parameter.Value --output text)"
      done
      echo "FLOWISE_ADMIN_EMAIL=${var.flowise_admin_email}"
      echo "OLLAMA_MODEL=${var.ollama_model}"
      echo "APP_URL=http://$PUBLIC_IP:3000"
    } > .env
    docker compose up -d --wait --wait-timeout 900
  EOT
}

resource "aws_instance" "this" {
  ami                    = data.aws_ssm_parameter.al2023_ami.value
  instance_type          = var.instance_type
  subnet_id              = data.aws_subnets.default.ids[0]
  vpc_security_group_ids = [aws_security_group.flowise.id]
  iam_instance_profile   = aws_iam_instance_profile.instance.name
  user_data              = local.user_data

  metadata_options {
    http_tokens = "required"
  }

  root_block_device {
    volume_size = var.root_volume_size_gb
    volume_type = "gp3"
    encrypted   = true
  }

  tags = {
    Name = var.name
  }

  depends_on = [aws_ssm_parameter.secret, aws_ssm_parameter.admin_password]
}

# ---------------------------------------------------------------- outputs

output "flowise_url" {
  description = "Flowise UI (allow a few minutes after apply for the first boot)"
  value       = "http://${aws_instance.this.public_ip}:3000"
}

output "admin_password_command" {
  description = "Prints the generated Flowise owner password"
  value       = "aws ssm get-parameter --region ${var.aws_region} --with-decryption --name ${aws_ssm_parameter.admin_password.name} --query Parameter.Value --output text"
}

output "ssm_session_command" {
  description = "Shell on the instance without SSH"
  value       = "aws ssm start-session --region ${var.aws_region} --target ${aws_instance.this.id}"
}
