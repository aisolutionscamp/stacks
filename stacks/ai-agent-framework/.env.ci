# Throwaway values for CI. Secrets are appended by ci-secrets.sh.
FLOWISE_PORT=3000
OLLAMA_PORT=11434
FLOWISE_ADMIN_NAME=CI
FLOWISE_ADMIN_EMAIL=ci@example.com
APP_URL=http://localhost:3000
LOG_LEVEL=info
DISABLE_FLOWISE_TELEMETRY=true
# Tiny model so the smoke test fits on a CPU-only runner
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_KEEP_ALIVE=5m
