# AI Agent Framework (Flowise + Ollama + PostgreSQL)
# Copy to .env and fill in every empty value before the first start.

# --- Ports (bound to 127.0.0.1 only) ---
# Flowise web UI and API
FLOWISE_PORT=3000
# Ollama API (for debugging and pulling models from the host)
OLLAMA_PORT=11434

# --- Flowise owner account (created automatically on first start) ---
# Display name of the owner account
FLOWISE_ADMIN_NAME=Admin
# Email address you log in with
FLOWISE_ADMIN_EMAIL=
# Password: 8-128 characters with lower case, upper case, a digit and a special character.
# Example: echo "Fw-7$(openssl rand -hex 12)"
FLOWISE_ADMIN_PASSWORD=

# --- Flowise secrets (generate each with: openssl rand -hex 32) ---
# Encrypts credentials stored in Flowise (provider API keys etc.). Keep it: if it changes, saved credentials can no longer be decrypted.
FLOWISE_SECRETKEY_OVERWRITE=
# Signs login tokens
JWT_AUTH_TOKEN_SECRET=
# Signs refresh tokens
JWT_REFRESH_TOKEN_SECRET=
# Signs session cookies
EXPRESS_SESSION_SECRET=
# Hashes password-reset and invite tokens
TOKEN_HASH_SECRET=

# --- Database ---
# Password of the "flowise" PostgreSQL user (generate with: openssl rand -hex 32)
POSTGRES_PASSWORD=

# --- Flowise settings ---
# Public URL of Flowise. With an https:// URL Flowise sets secure cookies.
APP_URL=http://localhost:3000
# error | warn | info | verbose | debug
LOG_LEVEL=info
# Set to false to send anonymous usage data to FlowiseAI
DISABLE_FLOWISE_TELEMETRY=true

# --- Ollama ---
# Model pulled on start. Pick one that supports tool calling for agents
# (for example llama3.2:3b, qwen3:4b, qwen2.5:7b).
OLLAMA_MODEL=llama3.2:3b
# How long a model stays in memory after the last request
OLLAMA_KEEP_ALIVE=5m
