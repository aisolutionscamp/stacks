# Throwaway CI settings. WEBUI_SECRET_KEY is appended by ci-secrets.sh.
# SMOKE_WEBUI_SIGNUP lets smoke-test.sh create an account on the empty test instance.
DEFAULT_MODEL=qwen2.5:0.5b
WEBUI_PORT=3000
WEBUI_URL=
WEBUI_NAME=LLM Chatbot CI
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending
ENABLE_OPENAI_API=false
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_VERSION=0.40.11
OPEN_WEBUI_VERSION=0.12.4
SMOKE_WEBUI_SIGNUP=true
