# Copy to .env and fill in the required values:  cp .env.example .env

# --- Required ---------------------------------------------------------------
# Signs Open WebUI login sessions (JWT). Generate with: openssl rand -hex 32
# Keep it stable: changing it logs out every user.
WEBUI_SECRET_KEY=

# --- Models -----------------------------------------------------------------
# Model the model-pull job downloads on start and Open WebUI preselects.
# Names from https://ollama.com/library. llama3.2 is the 3B model (about 2 GB download).
# Leave empty to skip the download and pull models later in the admin panel.
DEFAULT_MODEL=llama3.2

# --- Open WebUI -------------------------------------------------------------
# Host port for the chat UI (bound to 127.0.0.1 only).
WEBUI_PORT=3000
# Public URL of the UI, used in links and OAuth callbacks. Defaults to http://localhost:${WEBUI_PORT}.
WEBUI_URL=
# Name shown in the UI.
WEBUI_NAME=LLM Chatbot
# Allow new accounts. The first account becomes the admin. Set to false after you created it.
# Open WebUI stores this setting in its database after the first start; later changes are made
# in Admin Panel > Settings > General (the variable is only read on the first start).
ENABLE_SIGNUP=true
# Role for new sign-ups: pending (an admin must approve), user, or admin.
DEFAULT_USER_ROLE=pending
# Set to true to also use OpenAI-compatible APIs (keys are added in the admin panel).
ENABLE_OPENAI_API=false

# --- Ollama -----------------------------------------------------------------
# Host port for the Ollama API (bound to 127.0.0.1 only; the API has no authentication).
OLLAMA_PORT=11434
# How long a model stays loaded in memory after the last request.
OLLAMA_KEEP_ALIVE=5m
# Requests processed in parallel per model. Each slot needs extra memory for its context.
OLLAMA_NUM_PARALLEL=1
# Models kept loaded at the same time.
OLLAMA_MAX_LOADED_MODELS=1

# --- Image versions (change only when upgrading) ----------------------------
OLLAMA_VERSION=0.40.11
OPEN_WEBUI_VERSION=0.12.4
